# ---- Flash ----
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- PSRAM Octal 80MHz ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Objetos pequeños (<4KB) van a RAM interna, el resto a PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ---- CPU ----
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# ---- USB Serial JTAG (logger + datos) ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y

# ---- WiFi ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER=DYNAMIC
CONFIG_WIFI_PROV_ENABLED=n

# ---- BLE (NimBLE) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# ---- I2S ----
CONFIG_I2S_ENABLE_DEBUG_LOG=n

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# ---- ESP-SR / AFE ----
# Usamos el AFE solo para NS+VAD, sin WakeNet de Espressif
# (el wake word lo hace nuestro modelo TFLite custom)
CONFIG_USE_AFE=y
CONFIG_AFE_INTERFACE_V2=y
# Desactivar WakeNet de Espressif — usamos TFLite propio
CONFIG_USE_WAKENET=n
# Activar reducción de ruido por red neuronal (NSNet)
CONFIG_USE_NSNET=y
# VAD integrado en el AFE
CONFIG_AFE_CONFIG_VAD_ENABLED=y

# ---- NVS ----
CONFIG_NVS_ENCRYPTION=n

# ---- Logging ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
